{
	"name": "regulations",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --tsconfig tsconfig.seed.json src/lib/server/db/seed.ts",
		"db:seed:ny": "tsx --tsconfig tsconfig.seed.json src/lib/server/db/ny-ocm/seed-ny.ts",
		"db:seed:nj": "tsx --tsconfig tsconfig.seed.json src/lib/server/db/nj-crc/seed-nj.ts",
		"db:seed:nj:preprocess": "tsx --tsconfig tsconfig.seed.json src/lib/server/db/nj-crc/preprocess-columns.ts /tmp/nj-crc/njac-17-30-layout.txt /tmp/nj-crc/njac-17-30-clean.txt"
	},
	"devDependencies": {
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.0.0",
		"bits-ui": "^2.16.2",
		"drizzle-kit": "^0.31.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"svelte-sonner": "^1.0.7",
		"tailwind-variants": "^3.2.2",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@oslojs/crypto": "^1.0.0",
		"@oslojs/encoding": "^1.0.0",
		"better-auth": "^1.2.0",
		"clsx": "^2.1.0",
		"drizzle-orm": "^0.41.0",
		"lucide-svelte": "^0.475.0",
		"postgres": "^3.4.0",
		"tailwind-merge": "^3.0.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	}
}
